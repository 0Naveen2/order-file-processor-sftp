<!-- ========================================================= -->
<!-- TC-07: Main flow with one valid CREATE file              -->
<!-- Covers main SFTP pipeline and CREATE routing             -->
<!-- ========================================================= -->

<munit:test
    name="main-flow-valid-create-file-test"
    doc:name="TC-07 Main Flow Valid CREATE File"
    description="Covers the main SFTP processing flow with one file containing one valid CREATE record.">

    <munit:behavior>

        <!--
            Actual flow expects each sftp:list item to be a String
            because inputFilePath is set directly from payload.
        -->
        <munit-tools:mock-when
            processor="sftp:list"
            doc:name="Mock SFTP List">

            <munit-tools:then-return>
                <munit-tools:payload
                    value="#[['/inbound/orders.csv']]"
                    mediaType="application/java"/>
            </munit-tools:then-return>

        </munit-tools:mock-when>

        <!--
            Return an Array of Java Maps.

            The actual Parse CSV transform performs:
            output application/java
            -&#45;&#45;
            payload

            Therefore an Array of Maps remains compatible with the
            following record-level foreach.
        -->
        <munit-tools:mock-when
            processor="sftp:read"
            doc:name="Mock SFTP Read">

            <munit-tools:then-return>
                <munit-tools:payload
                    value="#[[
                        {
                            operation: 'CREATE',
                            customerId: 'CUST-001',
                            customerName: 'John Doe',
                            customerEmail: 'john.doe@example.com',
                            orderDate: '2026-10-11',
                            productCode: 'PROD-001',
                            quantity: '2',
                            currency: 'USD',
                            shippingAddressLine1: '123 Main Street',
                            shippingAddressLine2: '',
                            shippingCity: 'Hyderabad',
                            shippingState: 'Telangana',
                            shippingPostalCode: '500019',
                            shippingCountry: 'India'
                        }
                    ]]"
                    mediaType="application/java"/>
            </munit-tools:then-return>

        </munit-tools:mock-when>

        <!-- Prevent connection to the real RabbitMQ server -->
        <munit-tools:mock-when
            processor="amqp:publish"
            doc:name="Mock AMQP Publish">

            <munit-tools:then-return>
                <munit-tools:payload
                    value="#[payload]"
                    mediaType="application/json"/>
            </munit-tools:then-return>

        </munit-tools:mock-when>

        <!--
            Actual main flow calls sftp:move after processing.
            This mock prevents connection to the real SFTP server.
        -->
        <munit-tools:mock-when
            processor="sftp:move"
            doc:name="Mock SFTP Move">

            <munit-tools:then-return>
                <munit-tools:payload
                    value="#[payload]"
                    mediaType="application/java"/>
            </munit-tools:then-return>

        </munit-tools:mock-when>

    </munit:behavior>

    <munit:execution>

        <munit:set-event doc:name="Set Initial Event">
            <munit:payload
                value="#[null]"
                mediaType="application/java"/>
        </munit:set-event>

        <!-- Exact flow name from the application XML -->
        <flow-ref
            name="oms-order-file-processor-flow"
            doc:name="Run oms-order-file-processor-flow"/>

    </munit:execution>

    <munit:validation>

        <munit-tools:verify-call
            processor="sftp:list"
            times="1"
            doc:name="Verify SFTP List Called Once"/>

        <munit-tools:verify-call
            processor="sftp:read"
            times="1"
            doc:name="Verify SFTP Read Called Once"/>

        <munit-tools:verify-call
            processor="amqp:publish"
            times="1"
            doc:name="Verify CREATE Published Once"/>

        <munit-tools:verify-call
            processor="sftp:move"
            times="1"
            doc:name="Verify File Moved Once"/>

    </munit:validation>

</munit:test>

<!-- ========================================================= -->
<!-- TC-08: Main flow with invalid operation                   -->
<!-- Covers Route Operation choice otherwise branch            -->
<!-- ========================================================= -->

<munit:test
    name="main-flow-invalid-operation-test"
    doc:name="TC-08 Main Flow Invalid Operation"
    description="Covers the main-flow operation router otherwise branch and completes file archiving without calling AMQP.">

    <munit:behavior>

        <!--
            Actual flow expects String file paths because:
            inputFilePath = payload
            inputFileName = (payload splitBy '/')[-1]
        -->
        <munit-tools:mock-when
            processor="sftp:list"
            doc:name="Mock SFTP List">

            <munit-tools:then-return>
                <munit-tools:payload
                    value="#[['/inbound/invalid-operation.csv']]"
                    mediaType="application/java"/>
            </munit-tools:then-return>

        </munit-tools:mock-when>

        <!--
            Array containing one invalid operation record.
            The real inner foreach will process this record.
        -->
        <munit-tools:mock-when
            processor="sftp:read"
            doc:name="Mock SFTP Read">

            <munit-tools:then-return>
                <munit-tools:payload
                    value="#[[
                        {
                            operation: 'UNKNOWN',
                            customerName: 'John Doe'
                        }
                    ]]"
                    mediaType="application/java"/>
            </munit-tools:then-return>

        </munit-tools:mock-when>

        <!--
            Safety mock. Invalid operation must not reach AMQP.
        -->
        <munit-tools:mock-when
            processor="amqp:publish"
            doc:name="Mock AMQP Publish">

            <munit-tools:then-return>
                <munit-tools:payload
                    value="#[payload]"
                    mediaType="application/java"/>
            </munit-tools:then-return>

        </munit-tools:mock-when>

        <!--
            Invalid operation only logs an error.
            The application still reaches sftp:move afterward.
        -->
        <munit-tools:mock-when
            processor="sftp:move"
            doc:name="Mock SFTP Move">

            <munit-tools:then-return>
                <munit-tools:payload
                    value="#[payload]"
                    mediaType="application/java"/>
            </munit-tools:then-return>

        </munit-tools:mock-when>

    </munit:behavior>

    <munit:execution>

        <munit:set-event doc:name="Set Initial Event">
            <munit:payload
                value="#[null]"
                mediaType="application/java"/>
        </munit:set-event>

        <!-- Exact application flow name -->
        <flow-ref
            name="oms-order-file-processor-flow"
            doc:name="Run oms-order-file-processor-flow"/>

    </munit:execution>

    <munit:validation>

        <munit-tools:verify-call
            processor="sftp:list"
            times="1"
            doc:name="Verify SFTP List Called Once"/>

        <munit-tools:verify-call
            processor="sftp:read"
            times="1"
            doc:name="Verify SFTP Read Called Once"/>

        <!-- Invalid operation cannot call any AMQP publish -->
        <munit-tools:verify-call
            processor="amqp:publish"
            times="0"
            doc:name="Verify AMQP Publish Not Called"/>

        <!-- Flow continues after logging invalid operation -->
        <munit-tools:verify-call
            processor="sftp:move"
            times="1"
            doc:name="Verify Invalid Operation File Moved Once"/>

    </munit:validation>

</munit:test>

