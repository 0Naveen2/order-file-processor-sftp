        doc:name="MUnit Configuration"/>

    <!-- ========================================================= -->
    <!-- TC-01: Valid CREATE record                                -->
    <!-- ========================================================= -->

    <munit:test
        name="create-order-subflow-valid-create-test"
        doc:name="TC-01 Valid CREATE Record"
        description="Covers the successful branch of create-order-subflow and verifies AMQP publish.">

        <munit:behavior>

            <!--
                Mock the AMQP connector so that the test does not
                connect to the real RabbitMQ/AMQP server.
            -->
            <munit-tools:mock-when
                processor="amqp:publish"
                doc:name="Mock AMQP Publish">

                <munit-tools:then-return>
                    <munit-tools:payload
                        value="#[payload]"
                        mediaType="application/json"/>
                </munit-tools:then-return>

            </munit-tools:mock-when>

        </munit:behavior>

        <munit:execution>

            <!--
                All fields required by the actual CREATE validation
                condition are provided.
            -->
            <munit:set-event doc:name="Set Valid CREATE Event">

                <munit:payload
                    value="#[{
                        operation: 'CREATE',
                        customerId: 'CUST-001',
                        customerName: 'John Doe',
                        customerEmail: 'john.doe@example.com',
                        orderDate: '2026-10-11',
                        productCode: 'PROD-001',
                        quantity: '2',
                        currency: 'USD',
                        shippingAddressLine1: '123 Main Street',
                        shippingAddressLine2: '',
                        shippingCity: 'Hyderabad',
                        shippingState: 'Telangana',
                        shippingPostalCode: '500019',
                        shippingCountry: 'India'
                    }]"
                    mediaType="application/java"/>

            </munit:set-event>

            <!--
                Execute the exact subflow name present in subflows.xml.
            -->
            <flow-ref
                name="create-order-subflow"
                doc:name="Run create-order-subflow"/>

        </munit:execution>

        <munit:validation>

            <!--
                Verify that the successful CREATE branch reached
                the AMQP Publish component exactly once.
            -->
            <munit-tools:verify-call
                processor="amqp:publish"
                times="1"
                doc:name="Verify AMQP Publish Called Once"/>

        </munit:validation>

    </munit:test>
    <!-- ========================================================= -->
<!-- TC-02: Invalid CREATE record                              -->
<!-- Covers otherwise branch of Validate CREATE Record         -->
<!-- ========================================================= -->

<munit:test
    name="create-order-subflow-invalid-create-test"
    doc:name="TC-02 Invalid CREATE Record"
    description="Covers the invalid CREATE otherwise branch when customerName is missing and verifies that AMQP publish is not called.">

    <munit:behavior>

        <!--
            Mocking AMQP prevents any real RabbitMQ connection.
            The invalid branch should not reach this processor.
        -->
        <munit-tools:mock-when
            processor="amqp:publish"
            doc:name="Mock AMQP Publish">

            <munit-tools:then-return>
                <munit-tools:payload
                    value="#[payload]"
                    mediaType="application/java"/>
            </munit-tools:then-return>

        </munit-tools:mock-when>

    </munit:behavior>

    <munit:execution>

        <!--
            customerName is intentionally missing.
            This makes the actual CREATE validation condition false.
        -->
        <munit:set-event doc:name="Set Invalid CREATE Event">

            <munit:payload
                value="#[{
                    operation: 'CREATE',
                    customerEmail: 'john.doe@example.com',
                    productCode: 'PROD-001',
                    quantity: '2',
                    currency: 'USD',
                    shippingAddressLine1: '123 Main Street',
                    shippingAddressLine2: '',
                    shippingCity: 'Hyderabad',
                    shippingState: 'Telangana',
                    shippingPostalCode: '500019',
                    shippingCountry: 'India'
                }]"
                mediaType="application/java"/>

        </munit:set-event>

        <flow-ref
            name="create-order-subflow"
            doc:name="Run create-order-subflow"/>

    </munit:execution>

    <munit:validation>

        <!--
            The invalid CREATE branch must not publish a message.
        -->
        <munit-tools:verify-call
            processor="amqp:publish"
            times="0"
            doc:name="Verify AMQP Publish Not Called"/>

    </munit:validation>

</munit:test>

